rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;

      allow read, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }

    match /drinkEntries/{entryId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.quantity is int
        && request.resource.data.quantity != 0
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.type == 'beer'
            && request.resource.data.volumeLiters in [0.5, 0.66]
          )
          ||
          (
            request.resource.data.type == 'cocktail'
            && !('volumeLiters' in request.resource.data)
          )
        );

      allow update, delete: if false;
    }
  }
}
