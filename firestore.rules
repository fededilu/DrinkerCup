rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isChampionshipAdmin() {
      return request.auth != null
        && (
          resource.data.adminId == request.auth.uid
          || resource.data.memberRoles[request.auth.uid] == 'ADMIN'
        );
    }

    function isActiveChampionship() {
      return !('status' in resource.data) || resource.data.status != 'DELETED';
    }

    function isJoiningChampionship() {
      return request.auth != null
        && isActiveChampionship()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'memberRoles', 'memberCount', 'updatedAt'])
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberRoles[request.auth.uid] == 'PLAYER';
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;

      allow read, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }

    match /drinkEntries/{entryId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.quantity is int
        && request.resource.data.quantity != 0
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.type == 'beer'
            && request.resource.data.volumeLiters in [0.5, 0.66]
          )
          ||
          (
            request.resource.data.type == 'cocktail'
            && !('volumeLiters' in request.resource.data)
          )
        );

      allow update, delete: if false;
    }

    match /userStats/{userId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.points is number
        && request.resource.data.beer05Total is int
        && request.resource.data.beer066Total is int
        && request.resource.data.cocktailTotal is int
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /championships/{championshipId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberRoles[request.auth.uid] == 'ADMIN'
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.name is string
        && request.resource.data.code is string
        && request.resource.data.drinkConfig is list;

      allow update: if request.auth != null
        && (isChampionshipAdmin() || isJoiningChampionship());

      allow delete: if false;
    }

    match /championshipDrinkEntries/{entryId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.championshipId is string
        && request.resource.data.drinkKey is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity != 0
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /championshipStats/{statsId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.championshipId is string
        && request.resource.data.points is number
        && request.resource.data.drinkTotals is map
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
